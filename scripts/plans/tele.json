[
 {
  "until": "window.__game && !document.getElementById(\"boot\")",
  "timeout": 90000
 },
 {
  "eval": "JSON.stringify((window.__tele||[]).map(r=>r.ev))"
 },
 {
  "eval": "(()=>{let n=0; while(__game.dialogue.open && n<80){document.querySelector('.dlg').dispatchEvent(new PointerEvent('pointerdown',{bubbles:true})); n++;} __game.debug.quiet(); return n})()"
 },
 {
  "eval": "(()=>{const g=__game; g.timeScale=6; g.player.pos.set(6.25, 0, -2); window.dispatchEvent(new KeyboardEvent('keydown',{key:'w'})); return JSON.stringify({layout:g.st.layout, blocks:g.st.blocks.length, interval:+g.player.interval.toFixed(3)})})()"
 },
 {
  "until": "__game.player.stack.full",
  "timeout": 60000,
  "every": 300
 },
 {
  "eval": "(window.dispatchEvent(new KeyboardEvent('keyup',{key:'w'})), JSON.stringify({pos:[__game.player.pos.x.toFixed(1), __game.player.pos.z.toFixed(1)], prog:__game.progress().toFixed(2), carried:__game.player.stack.count}))"
 },
 {
  "snap": "fan_l1_full"
 },
 {
  "eval": "(__game.player.pos.copy(__game.furnace.zone.center), true)"
 },
 {
  "until": "__game.player.stack.count === 0",
  "timeout": 20000
 },
 {
  "until": "__game.furnace.output.count >= 3",
  "timeout": 30000
 },
 {
  "eval": "(__game.player.pos.set(__game.furnace.trayPos.x, 0, __game.furnace.trayPos.z + 1.2), true)"
 },
 {
  "until": "__game.player.stack.count >= 3",
  "timeout": 20000
 },
 {
  "eval": "(__game.player.pos.copy(__game.sales.zone.center), true)"
 },
 {
  "until": "__game.sales.moneyWaiting > 0",
  "timeout": 40000
 },
 {
  "eval": "(__game.player.pos.copy(__game.sales.moneyPos), true)"
 },
 {
  "until": "__game.sales.moneyWaiting === 0",
  "timeout": 20000
 },
 {
  "wait": 800
 },
 {
  "snap": "fan_l4_cash"
 },
 {
  "eval": "(()=>{const g=__game; g.debug.cash(5000); g.buyUpgrade(\"pickaxeAttackPower\"); g.buyTool(\"sledgehammer\"); return g.debug.state().cash})()"
 },
 {
  "eval": "(setTimeout(()=>{throw new Error(\"tele test\")}), window.dispatchEvent(new Event(\"pagehide\")), true)"
 },
 {
  "wait": 500
 },
 {
  "eval": "JSON.stringify((window.__tele||[]).map(r=>[r.ev,r.qid??r.key??r.msg??\"\",r.qi,r.pct,r.pl,r.ss].join(\" \")))"
 },
 {
  "eval": "JSON.stringify(window.__tele[0])"
 },
 {
