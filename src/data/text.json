  "dialogue": {
    "101": [
      "The fields are ripe and nobody's cut them, dear! Grab your tools and bring in the harvest."
    ],
    "102": [
      "Lovely load, dear! Raw harvest won't sell, though. Rice and wood go on MILL, rocks go on FORGE."
    ],
    "201": [
      "Nice cash, dear! Spend it at the Workshop for better tools."
    ],
    "301": [
      "Enough saved for a new tool. Off to the Farm Shop!"
    ],
    "302": [
      "Hand tools are yours to keep. Machines are rent-only."
    ],
    "401": [
      "Shiny new tools! Anything you buy here is yours for good.",
      "Tap EQUIPMENT any time you want to switch tools."
    ],
    "501": [
      "Rented! It's parked by the Mill. Hop in!"
    ],
    "502": [
      "Look at you behind the wheel! Smooth driving, dear.",
      "Getting off is easy too. Just tap the exit button.",
      "One catch: that button only shows up once you've stopped.",
      "Auntie's rule number one: full stop before you hop off!"
    ],
    "601": [
      "Out of diesel! Bring fuel cans over from FUEL."
    ],
    "801": [
      "Welcome to the Farm Office! Let's sharpen your tools in the Tool Shed."
    ],
    "802": [
      "Tour done! Ready for the next plot?"
    ],
    "803": [
      "The Tractor Barn is open! Research machines at the Farm Office, top corner."
    ],
    "804": [
      "Hi, I'm Bao! Swing by the Farm Office when you're done."
    ],
    "901": [
      "Too much work for one farmer? Hire a farmhand: the first one's free!"
    ],
    "902": [
      "Your farmhands live here. Lend them your tools and they work faster!"
    ],
    "903": [
      "Tired farmhands head to the Noodle Stall next door: a bowl, a drink or a nap and they're good as new.",
      "Throw them a NOODLE PARTY now and then. It keeps everyone going.",
      "Big team? Add more tables. No seat means no proper rest!"
    ],
    "1101": [
      "This plot's done! Sell your leftovers first, or move on when you like."
    ],
    "1201": [
      "Cashback! Spend on tools, hires and upgrades to earn rewards."
    ],
    "1501": [
      "Grab diesel cans at FUEL. Spare cans go in the bin right here."
    ],
    "1601": [
      "Tip, dear: once you're harvesting, let go. You'll keep working on your own."
    ]
  },
